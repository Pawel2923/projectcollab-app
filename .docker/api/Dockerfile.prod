#syntax=docker/dockerfile:1

# Adapted from https://github.com/dunglas/symfony-docker


# Versions
FROM dunglas/frankenphp:1-php8.4 AS frankenphp_upstream
FROM node:lts-alpine AS spa_builder

WORKDIR /spa
USER root

RUN npm install -g corepack@latest && \
	corepack enable && \
	corepack prepare --activate pnpm@10.25.0 && \
	pnpm config -g set store-dir /.pnpm-store

COPY --from=spa package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY --from=spa . ./
RUN pnpm run build


# Base FrankenPHP image
FROM frankenphp_upstream AS frankenphp_base

WORKDIR /app

# persistent / runtime deps
# hadolint ignore=DL3008
RUN apt-get update && apt-get install --no-install-recommends -y \
	acl \
	file \
	gettext \
	git \
	gosu \
	&& rm -rf /var/lib/apt/lists/*

# https://getcomposer.org/doc/03-cli.md#composer-allow-superuser
ENV COMPOSER_ALLOW_SUPERUSER=1

RUN set -eux; \
	install-php-extensions \
	@composer \
	apcu \
	gd \
	intl \
	opcache \
	redis \
	zip \
	;

###> recipes ###
###> doctrine/doctrine-bundle ###
RUN set -eux; \
	install-php-extensions pdo_pgsql
###< doctrine/doctrine-bundle ###
###< recipes ###

# Set up a non-root user
RUN groupadd -g 1000 symfony && \
	useradd -u 1000 -g symfony -m -s /bin/bash -d /home/symfony symfony

# Ensure Caddy directories and app directory are writable by non-root user
RUN mkdir -p /data /config /var/run/frankenphp /app/var && \
	chown -R symfony:symfony /data /config /var/run/frankenphp /app

COPY --link --from=frankenphp conf.d/app.ini $PHP_INI_DIR/conf.d/
COPY --link --from=frankenphp --chmod=755 docker-entrypoint.sh /usr/local/bin/docker-entrypoint
COPY --link --from=frankenphp Caddyfile /etc/caddy/Caddyfile
COPY --link --from=spa_builder /spa/dist /app/public/spa

ENTRYPOINT ["docker-entrypoint"]

HEALTHCHECK --start-period=60s CMD curl -f http://localhost:2019/metrics || exit 1
CMD [ "frankenphp", "run", "--config", "/etc/caddy/Caddyfile" ]

# Prod FrankenPHP image
FROM frankenphp_base AS frankenphp_prod

ENV APP_ENV=prod
ENV FRANKENPHP_CONFIG="import worker.Caddyfile"

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY --link --from=frankenphp conf.d/app.prod.ini $PHP_INI_DIR/conf.d/
COPY --link --from=frankenphp worker.Caddyfile /etc/caddy/worker.Caddyfile

# Switch to non-root user
USER symfony

# prevent the reinstallation of vendors at every changes in the source code
COPY --link --chown=1000:1000 composer.* symfony.* ./
RUN set -eux; \
	composer install --no-cache --prefer-dist --no-dev --no-autoloader --no-scripts --no-progress

# copy sources
COPY --link --chown=1000:1000 . ./
COPY --link --from=spa_builder /spa/dist /app/public/spa

RUN set -eux; \
	mkdir -p var/cache var/log; \
	composer dump-autoload --classmap-authoritative --no-dev; \
	composer dump-env prod; \
	composer run-script --no-dev post-install-cmd; \
	chmod +x bin/console; sync;
