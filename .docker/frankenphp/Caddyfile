{
	skip_install_trust
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	order mercure after encode
	order vulcain after reverse_proxy
	order php_server before file_server
}

{$CADDY_EXTRA_CONFIG}

(app_config) {
	log {
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root * /app/public
	@compressible not path /.well-known/mercure*
	encode @compressible zstd br gzip

	vulcain

	header ?Link `</docs.jsonld>; rel="http://www.w3.org/ns/hydra/core#apiDocumentation", </.well-known/mercure>; rel="mercure"`
	header ?Permissions-Policy "browsing-topics=()"

	handle /.well-known/mercure* {
		mercure {
			name default
			transport_url {$MERCURE_TRANSPORT_URL:bolt:///data/mercure.db}
			issuer {$MERCURE_TRUSTED_ISSUERS:https://localhost} {
				publisher {
					jwt {env.MERCURE_PUBLISHER_JWT_KEY}
				}
				subscriber {
					jwt {env.MERCURE_SUBSCRIBER_JWT_KEY}
				}
			}

			anonymous
			subscriptions

			{$MERCURE_EXTRA_DIRECTIVES}
		}
	}

	@api path /core-api* /docs* /graphql* /bundles* /contexts* /_profiler* /_wdt*
	handle @api {
		file_server

		php_server {
			try_files {path} index.php
			resolve_root_symlink
		}
	}

	handle /spa* {
		try_files {path} /spa/index.html
		file_server
	}

	handle {
		reverse_proxy http://{$FRONTEND_UPSTREAM}
	}
}

{$SERVER_NAME:localhost} {
	tls {$CADDY_TLS:internal}
	import app_config
}

api:80 {
	import app_config
}
